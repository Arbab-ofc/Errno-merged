# Copy into the deployment secret manager; never commit real credentials.
RAZORPAY_KEY_ID=rzp_test_replace-me
RAZORPAY_KEY_SECRET=replace-with-a-server-only-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-an-independent-webhook-secret
RAZORPAY_ENVIRONMENT=test
RAZORPAY_API_TIMEOUT_SECONDS=10
# Enable only after provider-approved payout method and KYC verification exist.
ERRNO_PAYOUT_METHOD_VERIFICATION_ENABLED=false
# Business policies intentionally remain blocked until approved and implemented.
ERRNO_CASH_SETTLEMENT_POLICY=unconfigured
ERRNO_CANCELLATION_REFUND_POLICY=unconfigured
