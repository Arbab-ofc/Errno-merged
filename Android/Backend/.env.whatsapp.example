# Generate independent random secrets (at least 32 bytes) outside source control.
WHATSAPP_GATEWAY_ENABLED=false
WHATSAPP_GATEWAY_INTERNAL_URL=http://whatsapp-gateway:8787
WHATSAPP_GATEWAY_INTERNAL_AUTH_SECRET=replace-with-random-secret-at-least-32-characters
WHATSAPP_GATEWAY_TIMEOUT_SECONDS=35
WHATSAPP_OTP_HASH_SECRET=replace-with-another-random-secret-at-least-32-characters
WHATSAPP_OTP_LENGTH=6
