WHATSAPP_OTP_RESEND_SECONDS=30
WHATSAPP_OTP_MAX_ATTEMPTS=5
WHATSAPP_OTP_PHONE_LIMIT_PER_HOUR=5
WHATSAPP_OTP_IP_LIMIT_PER_HOUR=20
