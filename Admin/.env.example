# ERRNO API origin. Use the ignored .env.local for temporary tunnel overrides.
VITE_API_BASE_URL=http://localhost:8000
# Firebase web client configuration (public identifiers only; never put service-account keys here).
VITE_FIREBASE_API_KEY=replace-with-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=errno-pvt-ltd.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=errno-pvt-ltd
VITE_FIREBASE_APP_ID=replace-with-firebase-web-app-id
