// Copy to iOS/Local.xcconfig (ignored by Git) and pass it to Xcode as needed.
ERRNO_API_BASE_URL = https://api.example.com

// Separate iOS Maps SDK key. Restrict by the registered bundle identifier.
ERRNO_GOOGLE_MAPS_IOS_API_KEY = YOUR_IOS_MAPS_API_KEY

// Temporary address search service; this is not a Google Maps Platform key.
ERRNO_PHOTON_ENDPOINT = https://photon.komoot.io

// Xcode loads this tracked example as the target base configuration. A private,
// ignored Local.xcconfig can override these example values on the same machine.
#include? "Local.xcconfig"
