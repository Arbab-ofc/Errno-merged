# Configuration reference. Native mobile apps load platform-specific settings;
# this root file is not automatically loaded by Android or Xcode.

# Google Maps SDK keys must be separate per platform and must be restricted.
ERRNO_GOOGLE_MAPS_ANDROID_API_KEY=YOUR_ANDROID_MAPS_API_KEY
ERRNO_GOOGLE_MAPS_IOS_API_KEY=YOUR_IOS_MAPS_API_KEY

# Temporary Photon address search endpoint; no Google Places/Geocoding API is used.
ERRNO_PHOTON_ENDPOINT=https://photon.komoot.io
