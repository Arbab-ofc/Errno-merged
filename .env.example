# ERRNO shared local/deployment configuration reference.
# Copy to an ignored .env and replace placeholders in your local secret store.
# Empty values are intentionally unset; do not enable an integration without
# its approved credentials, provider setup, and operational controls.

# -----------------------------------------------------------------------------
# Backend runtime and database
# -----------------------------------------------------------------------------
APP_ENV=development
ENVIRONMENT=development
LOG_LEVEL=info
DATABASE_URL=
ERRNO_DATABASE_URL=
ERRNO_TEST_DATABASE_URL=
PGSSLROOTCERT=
ERRNO_PGSSLROOTCERT=
ERRNO_ALLOW_LOCAL_TEST_DB=
ERRNO_ALLOW_CANONICAL_MIGRATION=
ERRNO_CORS_ALLOWED_ORIGINS=
ERRNO_OSRM_ENDPOINT=https://router.project-osrm.org/route/v1/driving

# Firebase Admin credentials are server-only. Use ADC/managed identity where possible.
FIREBASE_PROJECT_ID=errno-pvt-ltd
GOOGLE_APPLICATION_CREDENTIALS=

# -----------------------------------------------------------------------------
# Android/iOS mobile build settings
# -----------------------------------------------------------------------------
# Android emulator backend URL is usually http://10.0.2.2:8000.
ERRNO_API_BASE_URL=http://localhost:8000
ERRNO_GOOGLE_MAPS_ANDROID_API_KEY=YOUR_ANDROID_MAPS_API_KEY
ERRNO_GOOGLE_MAPS_IOS_API_KEY=YOUR_IOS_MAPS_API_KEY
ERRNO_PHOTON_ENDPOINT=https://photon.komoot.io
ERRNO_FIREBASE_AUTH_EMULATOR_HOST=
# iOS development-only switch; set in the Xcode run environment if needed.
ERRNO_FIREBASE_AUTH_EMULATOR=

# -----------------------------------------------------------------------------
# Admin web client (Vite only exposes VITE_ variables to browser bundles)
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
VITE_FIREBASE_API_KEY=replace-with-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=errno-pvt-ltd.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=errno-pvt-ltd
VITE_FIREBASE_APP_ID=replace-with-firebase-web-app-id

# -----------------------------------------------------------------------------
# Pricing/payout policy gates. Values are not commercial approvals.
# -----------------------------------------------------------------------------
ERRNO_PAYOUT_METHOD_VERIFICATION_ENABLED=false
ERRNO_CASH_SETTLEMENT_POLICY=unconfigured
ERRNO_CANCELLATION_REFUND_POLICY=unconfigured

# -----------------------------------------------------------------------------
# Pre-booking dispatch worker (run as a separate supervised process)
# -----------------------------------------------------------------------------
PREBOOKING_DISPATCH_POLL_SECONDS=1
PREBOOKING_DISPATCH_LEASE_SECONDS=120
PREBOOKING_NO_WORKER_RETRY_SECONDS=300
PREBOOKING_WORKER_RADIUS_KM=5
PREBOOKING_LOCATION_MAX_AGE_SECONDS=300

# -----------------------------------------------------------------------------
# Notification outbox and FCM
# -----------------------------------------------------------------------------
NOTIFICATION_WORKER_ENABLED=true
NOTIFICATION_PUSH_ENABLED=false
NOTIFICATION_MAX_ATTEMPTS=6
NOTIFICATION_RETRY_BASE_SECONDS=15
NOTIFICATION_RETRY_MAX_SECONDS=3600
NOTIFICATION_LEASE_SECONDS=120
NOTIFICATION_WORKER_POLL_SECONDS=2
NOTIFICATION_RETENTION_DAYS=365
NOTIFICATION_DELIVERY_LOG_RETENTION_DAYS=180
NOTIFICATION_TOKEN_ENCRYPTION_KEY=
NOTIFICATION_TOKEN_HASH_SECRET=

# -----------------------------------------------------------------------------
# Razorpay (server-side secrets; test environment by default)
# -----------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_replace-me
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_ENVIRONMENT=test
RAZORPAY_API_TIMEOUT_SECONDS=10

# -----------------------------------------------------------------------------
# KYC and DigiLocker (provider disabled/fail-closed pending approval)
# -----------------------------------------------------------------------------
DIGILOCKER_ENABLED=false
DIGILOCKER_PROVIDER_MODE=disabled
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
DIGILOCKER_REDIRECT_URI=
DIGILOCKER_ALLOWED_SCOPES=
DIGILOCKER_API_BASE_URL=
DIGILOCKER_AUTHORIZATION_URL=
DIGILOCKER_TOKEN_URL=
DIGILOCKER_SESSION_TTL_SECONDS=600
DIGILOCKER_HTTP_TIMEOUT_SECONDS=15
DIGILOCKER_STATE_SECRET=
# Deprecated template name retained for compatibility; current code does not read it.
DIGILOCKER_DOCUMENT_RETENTION_DAYS=
KYC_MANUAL_REVIEW_ENABLED=false
KYC_REQUIRED_FOR_WITHDRAWAL=true
KYC_DOCUMENT_RETENTION_DAYS=0
KYC_CONSENT_VERSION=v1
KYC_ALLOWED_DOCUMENT_TYPES=
KYC_DOCUMENT_ENCRYPTION_KEY=
KYC_MANUAL_STORAGE_PATH=
KYC_ANTIVIRUS_MODE=quarantine
KYC_CLAMAV_UNIX_SOCKET=

# -----------------------------------------------------------------------------
# WhatsApp OTP backend and private gateway
# -----------------------------------------------------------------------------
WHATSAPP_GATEWAY_ENABLED=false
WHATSAPP_GATEWAY_INTERNAL_URL=http://whatsapp-gateway:8787
WHATSAPP_GATEWAY_INTERNAL_AUTH_SECRET=
WHATSAPP_GATEWAY_TIMEOUT_SECONDS=35
WHATSAPP_OTP_HASH_SECRET=
WHATSAPP_OTP_LENGTH=6
WHATSAPP_OTP_TTL_SECONDS=300
WHATSAPP_OTP_RESEND_SECONDS=30
WHATSAPP_OTP_MAX_ATTEMPTS=5
WHATSAPP_OTP_PHONE_LIMIT_PER_HOUR=5
WHATSAPP_OTP_IP_LIMIT_PER_HOUR=20
WHATSAPP_SESSION_TTL_SECONDS=2592000
WHATSAPP_SESSION_MAX_ACTIVE=5
WHATSAPP_GATEWAY_BIND=127.0.0.1
WHATSAPP_GATEWAY_PORT=8787
WHATSAPP_GATEWAY_SESSION_PATH=./session
WHATSAPP_GATEWAY_AUTOCONNECT=true
WHATSAPP_GATEWAY_QR_TTL_SECONDS=60
